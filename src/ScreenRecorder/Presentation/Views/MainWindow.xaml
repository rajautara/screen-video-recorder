<Window x:Class="ScreenRecorder.Presentation.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Screen Recorder"
        Height="500"
        Width="700"
        MinHeight="400"
        MinWidth="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">

    <Window.Resources>
        <!-- Styles will be loaded from theme dictionaries -->
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Bar -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Screen Recorder"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="White"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding StatusText}"
                               FontSize="14"
                               Foreground="#ECF0F1"
                               Margin="20,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="⚙"
                        FontSize="16"
                        Width="35"
                        Height="35"
                        Command="{Binding OpenSettingsCommand}"
                        ToolTip="Settings"/>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Profile Selection -->
            <GroupBox Grid.Row="0" Header="Recording Profile" Margin="0,0,0,15">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox Grid.Column="0"
                              ItemsSource="{Binding Profiles}"
                              SelectedItem="{Binding SelectedProfile}"
                              DisplayMemberPath="Name"
                              Height="30"
                              VerticalContentAlignment="Center"/>

                    <Button Grid.Column="1"
                            Content="Select Region"
                            Margin="10,0,0,0"
                            Padding="15,5"
                            Command="{Binding SelectRegionCommand}"/>
                </Grid>
            </GroupBox>

            <!-- Recording Controls -->
            <GroupBox Grid.Row="1" Header="Controls" Margin="0,0,0,15">
                <StackPanel Margin="10">
                    <!-- Duration Display -->
                    <TextBlock Text="{Binding DurationText}"
                               FontSize="48"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,20"/>

                    <!-- Control Buttons -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="⏺ Start"
                                Height="50"
                                FontSize="16"
                                Margin="0,0,5,0"
                                Command="{Binding StartRecordingCommand}"
                                Background="#27AE60"
                                Foreground="White"
                                BorderThickness="0"/>

                        <Button Grid.Column="1"
                                Height="50"
                                FontSize="16"
                                Margin="5,0,5,0"
                                Command="{Binding PauseResumeCommand}"
                                Background="#F39C12"
                                Foreground="White"
                                BorderThickness="0">
                            <Button.Content>
                                <TextBlock>
                                    <Run Text="⏸"/>
                                    <Run Text="{Binding IsPaused, Converter={StaticResource PauseResumeTextConverter}, FallbackValue='Pause'}"/>
                                </TextBlock>
                            </Button.Content>
                        </Button>

                        <Button Grid.Column="2"
                                Content="⏹ Stop"
                                Height="50"
                                FontSize="16"
                                Margin="5,0,5,0"
                                Command="{Binding StopRecordingCommand}"
                                Background="#E74C3C"
                                Foreground="White"
                                BorderThickness="0"/>

                        <Button Grid.Column="3"
                                Content="🔴 Marker"
                                Height="50"
                                FontSize="16"
                                Margin="5,0,0,0"
                                Command="{Binding DropMarkerCommand}"
                                Background="#3498DB"
                                Foreground="White"
                                BorderThickness="0"/>
                    </Grid>
                </StackPanel>
            </GroupBox>

            <!-- Audio Levels -->
            <GroupBox Grid.Row="2" Header="Audio Levels" Margin="0,0,0,15">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- System Audio -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="System Audio" Margin="0,0,0,5"/>
                        <ProgressBar Height="20"
                                     Minimum="0"
                                     Maximum="1"
                                     Value="{Binding SystemAudioLevel}"
                                     Foreground="#27AE60"/>
                    </StackPanel>

                    <!-- Microphone -->
                    <StackPanel Grid.Row="1">
                        <TextBlock Text="Microphone" Margin="0,0,0,5"/>
                        <ProgressBar Height="20"
                                     Minimum="0"
                                     Maximum="1"
                                     Value="{Binding MicrophoneLevel}"
                                     Foreground="#3498DB"/>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <!-- Status Info -->
            <Border Grid.Row="3"
                    Background="#ECF0F1"
                    Padding="15"
                    CornerRadius="5">
                <StackPanel>
                    <TextBlock Text="Quick Tips:" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock Text="• Press F9 to start/stop recording" Margin="0,0,0,5"/>
                    <TextBlock Text="• Press F10 to pause/resume" Margin="0,0,0,5"/>
                    <TextBlock Text="• Press F12 to drop a marker" Margin="0,0,0,5"/>
                    <TextBlock Text="• Select a profile and click Start to begin" Margin="0,0,0,5"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#34495E" Padding="10,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding StatusText}"
                           Foreground="White"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="v1.0.0"
                               Foreground="#BDC3C7"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
